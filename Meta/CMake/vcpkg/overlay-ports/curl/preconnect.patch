diff --git a/lib/http2.c b/lib/http2.c
index 9010179..2e95741 100644
--- a/lib/http2.c
+++ b/lib/http2.c
@@ -1842,8 +1842,11 @@ out:
   }
   /* Defer flushing during the connect phase so that the SETTINGS and
    * other initial frames are sent together with the first request.
-   * Unless we are 'connect_only' where the request will never come. */
-  if(!cf->connected && !cf->conn->bits.connect_only)
+   * Unless we are 'connect_only' where the request will never come, which
+   * goes for a preconnect too: its connection may wait in the pool for a
+   * while, and servers expect the connection preface soon. */
+  if(!cf->connected && !cf->conn->bits.connect_only &&
+     !(data && data->set.connect_only_preconnect))
     return CURLE_OK;
   return nw_out_flush(cf, data);
 }
