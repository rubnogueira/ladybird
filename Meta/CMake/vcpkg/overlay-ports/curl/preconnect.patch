+      if(Curl_conn_recv(admin, FIRSTSOCKET, buf, sizeof(buf), &nread) ==
+         CURLE_AGAIN)
+        input_pending = FALSE;
+    }
     Curl_detach_connection(admin);
     if(healthy && input_pending && poll_input) {
