--- a/lib/conncache.c
+++ b/lib/conncache.c
@@ -1071,6 +1071,18 @@ bool Curl_cpool_conn_seems_healthy(struct connectdata *conn,
 
     Curl_attach_connection(admin, conn, FALSE);
     healthy = Curl_conn_is_alive(admin, conn, &input_pending);
+    if(healthy && input_pending && poll_input && conn->bits.preconnected &&
+       Curl_conn_is_ssl(conn, FIRSTSOCKET)) {
+      /* A preconnect is done once the TLS handshake is, so nothing has read
+       * what the server sent after it, like TLS 1.3 session tickets. Let TLS
