From: Ladybird
Subject: connect: add a preconnect level of CURLOPT_CONNECT_ONLY whose connection can be reused

diff --git a/include/curl/curl.h b/include/curl/curl.h
index ccc9a09..ee414e5 100644
--- a/include/curl/curl.h
+++ b/include/curl/curl.h
@@ -2334,6 +2334,14 @@ typedef enum {
   /* Convenient "aliases" */
 #define CURLOPT_RTSPHEADER CURLOPT_HTTPHEADER
 
+/* Ladybird: a value for CURLOPT_CONNECT_ONLY that connects like 1L does, but
+   leaves the connection in the connection pool for later transfers to reuse,
+   as a browser's preconnect would. It reuses a matching connection that is
+   already there instead of opening another one. The application cannot use
+   the connection with curl_easy_send() and curl_easy_recv(). */
+#define CURL_CONNECT_ONLY_PRECONNECT 3L
+#define LIBCURL_HAS_CONNECT_ONLY_PRECONNECT 1
+
 /* These constants are for use with the CURLOPT_HTTP_VERSION option. */
 #define CURL_HTTP_VERSION_NONE  0L /* setting this means we do not care, and
                                       that we would like the library to choose
diff --git a/lib/conncache.c b/lib/conncache.c
