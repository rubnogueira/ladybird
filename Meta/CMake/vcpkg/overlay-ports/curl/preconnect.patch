diff --git a/lib/setopt.c b/lib/setopt.c
index dff8a6d..7c04836 100644
--- a/lib/setopt.c
+++ b/lib/setopt.c
@@ -840,11 +840,12 @@ static CURLcode setopt_long_net(struct Curl_easy *data, CURLoption option,
       s->ipver = (unsigned char)arg;
     break;
   case CURLOPT_CONNECT_ONLY:
