+#if !defined(CURL_DISABLE_HTTP) && defined(USE_HTTP2)
+/* Ladybird: CURLOPT_COALESCE. */
+struct url_coalesce_match {
+  struct url_conn_match *m;
+  const struct Curl_dns_entry *dns;
+};
+
+/* Whether conn is to an address that the transfer's host resolves to. */
+static bool url_coalesce_addr_matches(struct connectdata *conn,
+                                      struct url_coalesce_match *c)
+{
+  struct ip_quadruple ipquad;
+  const struct Curl_addrinfo *ai;
+  bool is_ipv6;
+
+  if(Curl_conn_get_ip_info(c->m->data, conn, FIRSTSOCKET, &is_ipv6, &ipquad))
+    return FALSE;
+  for(ai = c->dns->addr; ai; ai = ai->ai_next) {
+    char ip[MAX_IPADR_LEN];
+    Curl_printable_address(ai, ip, sizeof(ip));
+    if(!strcmp(ip, ipquad.remote_ip))
+      return TRUE;
+  }
+  return FALSE;
+}
+
+/* Whether conn, an HTTP/2 connection to another host, may carry the
+ * transfer: it would were it to the transfer's host, it is to an address
+ * that host resolves to, and the certificate it verified covers that host.
+ * Never closes a connection, as this goes through the whole pool. */
+static cpool_match_result url_match_coalesce(struct connectdata *conn,
+                                             void *userdata)
+{
+  struct url_coalesce_match *c = userdata;
+  struct url_conn_match *m = c->m;
+
+  /* Connections to the transfer's own host were looked at already. */
+  if(conn->origin->scheme != m->needle->origin->scheme ||
+     conn->origin->port != m->needle->origin->port ||
+     Curl_peer_same_destination(conn->origin, m->needle->origin) ||
+     conn->via_peer)
+    return CPOOL_MATCH_CONT;
+#ifndef CURL_DISABLE_PROXY
+  if(conn->bits.origin_is_proxy || conn->http_proxy.peer ||
+     conn->socks_proxy.peer)
+    return CPOOL_MATCH_CONT;
+#endif
+
+  if(!url_match_connect_config(conn, m) ||
+     !url_match_fully_connected(conn, m))
+    return CPOOL_MATCH_CONT;
+
+  if(!conn->bits.multiplex || (Curl_conn_http_version(m->data, conn) != 20))
+    return CPOOL_MATCH_CONT;
+
+  if(!url_match_multiplex_needs(conn, m) ||
+     !url_match_ssl_use(conn, m) ||
+     !url_match_ssl_config(conn, m) ||
+     !url_match_auth(conn, m) ||
+     !url_match_proto_config(conn, m) ||
+     !url_match_auth_ntlm(conn, m) ||
+     !url_match_auth_nego(conn, m) ||
+     !url_match_multiplex_limits(conn, m))
+    return CPOOL_MATCH_CONT;
+
+  if((m->data->set.conn_max_age_ms > 0) &&
+     (Curl_cpool_conn_age_ms(m->data, conn, &m->now) >
+      m->data->set.conn_max_age_ms))
+    return CPOOL_MATCH_CONT;
+
+  if(!url_coalesce_addr_matches(conn, c) ||
+     !Curl_ssl_conn_cert_covers_host(m->data, conn,
+                                     m->needle->origin->hostname))
+    return CPOOL_MATCH_CONT;
+
+  if(!CONN_INUSE(conn) &&
+     !Curl_cpool_conn_seems_healthy(conn, m->data, &m->now))
+    return CPOOL_MATCH_CONT;
+
+  m->found = conn;
+  return CPOOL_MATCH_FOUND;
+}
+
+static bool url_coalesce_result(void *userdata)
+{
+  struct url_coalesce_match *c = userdata;
+  if(c->m->found) {
+    /* Attach it while still under lock, as url_match_result() does. */
+    Curl_attach_connection(c->m->data, c->m->found, TRUE);
+    return TRUE;
+  }
+  return FALSE;
+}
+
+/*
+ * Ladybird: CURLOPT_COALESCE. Given a transfer that found no connection to
+ * its host to reuse, find and attach an HTTP/2 connection to another host
+ * that may carry it, as browsers do (RFC 9113, section 9.1.1).
+ *
+ * Return TRUE if such a connection was attached.
+ */
+static bool url_attach_coalesced(struct Curl_easy *data,
+                                 struct connectdata *needle,
+                                 struct url_conn_match *m,
+                                 const struct curltime *pnow)
+{
+  struct url_coalesce_match c;
+  struct Curl_dns_entry *dns = NULL;
+  bool found;
+
+  if(!data->set.coalesce || data->state.no_coalesce ||
+     (needle->scheme->protocol != CURLPROTO_HTTPS) ||
+     !m->may_multiplex ||
+     !(data->state.http_neg.allowed & CURL_HTTP_V2x) ||
+     !m->ssl_config.verifypeer || !m->ssl_config.verifyhost ||
+     needle->creds || needle->via_peer ||
+     Curl_host_is_ipnum(needle->origin->hostname))
+    return FALSE;
+#ifndef CURL_DISABLE_PROXY
+  if(needle->bits.origin_is_proxy || needle->http_proxy.peer ||
+     needle->socks_proxy.peer)
+    return FALSE;
+#endif
+
+  /* Only an address the host is known to resolve to will do. */
+  if(Curl_dnscache_get(data, Curl_resolv_dns_queries(data, needle->ip_version),
+                       needle->origin, &dns) || !dns)
+    return FALSE;
+
+  c.m = m;
+  c.dns = dns;
+  m->found = NULL;
+  found = Curl_cpool_find(data, NULL, FALSE, pnow, url_match_coalesce,
+                          url_coalesce_result, &c);
+  Curl_dns_entry_unlink(data, &dns);
+  return found;
+}
+#else
+#define url_attach_coalesced(d, n, m, p) \
+  ((void)(d), (void)(n), (void)(m), (void)(p), FALSE)
+#endif
