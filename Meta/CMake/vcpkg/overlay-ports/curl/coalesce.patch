+bool Curl_ossl_cert_covers_host(void *ssl, const char *hostname)
+{
+  X509 *cert = SSL_get1_peer_certificate((SSL *)ssl);
+  bool covers;
+
+  if(!cert)
+    return FALSE;
+  /* As browsers match, by the certificate's subject alternative names. */
+  covers = X509_check_host(cert, hostname, 0,
+                           X509_CHECK_FLAG_NEVER_CHECK_SUBJECT |
+                           X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS, NULL) == 1;
+  X509_free(cert);
+  return covers;
+}
